# Positive allowlist: local secrets, legacy archives and Git cannot enter context.
**
!Dockerfile
!requirements/
requirements/**
!requirements/*.txt
!src/
src/**
!src/*.py
!src/publisher/
src/publisher/**
!src/publisher/*.py
!src/brocker/
src/brocker/**
!src/brocker/*.py
!src/web/
src/web/**
!src/web/*.py
!src/web/requirements.txt
!src/web/templates/
src/web/templates/**
!src/web/templates/*.html
!src/web/static/
src/web/static/**
!src/web/static/**
!src/web/ascon/
src/web/ascon/**
!src/web/ascon/*.py
!src/web/ascon/LICENSE
!scripts/
scripts/**
!scripts/*.py
!scripts/mqtt_smoke.py
!scripts/prepare_compose.py
!deploy/
deploy/**
!deploy/compose.env.example
!tests/
tests/**
!tests/*.py
!pyproject.toml

# Explicit exclusions also apply after all allow rules.
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.zip
**/.env*

!alembic.ini
!migrations/
!migrations/**

!src/classifier/
src/classifier/**
!src/classifier/ml/
!src/classifier/ml/*.py

# Keep secret/cache exclusions last, including after ML source allow rules.
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.zip
**/.env*
