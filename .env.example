# Copy to .env (ignored). Fill secrets locally; never commit .env.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://lightcrypto:CHANGE_ME@127.0.0.1:5432/lightcrypto
FLASK_SECRET_KEY=
# Provision only this device key using the v2 registry schema; see docs/MQTT_PROTOCOL.md.
DEVICE_REGISTRY_FILE=.local-runtime/publisher/registry.json
PUBLISHER_STATE_FILE=.local-runtime/publisher/sequence.db
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USERNAME=publisher
MQTT_PASSWORD_FILE=.local-runtime/security/publisher.password
MQTT_CA_FILE=.local-runtime/security/ca.crt
MQTT_TOPIC=iot/sensors/#
MQTT_PUBLISH_TOPIC=iot/sensors/raspb1
DEVICE_ID=raspb1
MQTT_CLIENT_ID=raspb1
PUBLISH_INTERVAL=10
# Native web: set its own MQTT role/registry and 1 to connect to the protected broker.
WEB_MQTT_ENABLED=0
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Empty LOG_FILE uses stderr. Example: logs/flask_mqtt.log
LOG_FILE=
# Optional initial accounts; unset passwords do not create accounts.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_VIEWER_PASSWORD=
